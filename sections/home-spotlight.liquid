{%- comment -%}
  Terra Arts: ABASK 风格的橘色 Spotlight 版块(type-forward, 进店 CTA)。
  全站唯一高饱和色,作视觉锚点。橘色集中在 --sp-bg。
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="home-spotlight"
  style="--sp-bg: {{ s.bg_color }}; --sp-pt: {{ s.padding_top }}px; --sp-pb: {{ s.padding_bottom }}px;"
>
  <div class="home-spotlight__inner page-width">
    {%- if s.eyebrow != blank -%}
      <span class="home-spotlight__eyebrow">{{ s.eyebrow }}</span>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="home-spotlight__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="home-spotlight__text">{{ s.text }}</p>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="home-spotlight__btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
        {{ s.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .home-spotlight {
    background-color: var(--sp-bg, #e2682e);
    color: #fff;
    padding-block: var(--sp-pt, 72px) var(--sp-pb, 72px);
    text-align: center;
  }
  .home-spotlight__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .home-spotlight__eyebrow {
    font-family: var(--font-body--family, sans-serif);
    font-size: .75rem;
    letter-spacing: .28em;
    text-transform: uppercase;
    opacity: .9;
  }
  .home-spotlight__heading {
    font-family: var(--font-heading--family, serif);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.4vw, 2.75rem);
    line-height: 1.4;
    margin: 0;
    max-width: 20em;
  }
  .home-spotlight__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: clamp(.95rem, 1.1vw, 1.0625rem);
    line-height: 1.9;
    letter-spacing: .04em;
    margin: 0;
    max-width: 38em;
    opacity: .96;
  }
  .home-spotlight__btn {
    display: inline-block;
    margin-top: 10px;
    padding: 14px 40px;
    background: #fff;
    color: var(--sp-bg, #e2682e);
    text-decoration: none;
    font-size: .9375rem;
    letter-spacing: .08em;
    border-radius: 2px;
    transition: opacity .25s, transform .25s;
  }
  .home-spotlight__btn:hover {
    opacity: .88;
    transform: translateY(-1px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home spotlight",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SPOTLIGHT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ひとつとして同じものがない、ムラーノの手仕事" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "色とりどりの手吹きガラス。あなたの暮らしに、ヴェネチアの光を。" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "コレクションを見る" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#e2682e" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [{ "name": "Home spotlight" }]
}
{% endschema %}
