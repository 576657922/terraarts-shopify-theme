{%- comment -%}
  Terra Arts: ABASK 风格的橘色 Spotlight 版块(type-forward, 进店 CTA)。
  全站唯一高饱和色,作视觉锚点。橘色集中在 --sp-bg。
{%- endcomment -%}
{%- assign s = section.settings -%}

<section
  class="home-spotlight"
  style="--sp-bg: {{ s.bg_color }}; --sp-pt: {{ s.padding_top }}px; --sp-pb: {{ s.padding_bottom }}px;"
>
  <div class="home-spotlight__inner page-width">
    {%- if s.eyebrow != blank -%}
      <span class="home-spotlight__eyebrow">{{ s.eyebrow }}</span>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="home-spotlight__heading">{{ s.heading }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <p class="home-spotlight__text">{{ s.text }}</p>
    {%- endif -%}
    {%- if s.button_label != blank -%}
      <a class="home-spotlight__btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
        <span class="home-spotlight__btn-text">{{ s.button_label }}</span>
        <span class="home-spotlight__arrow" aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .home-spotlight {
    background-color: var(--sp-bg, #d97a40);
    color: #fff;
    padding-block: var(--sp-pt, 104px) var(--sp-pb, 104px);
    text-align: center;
  }
  .home-spotlight__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    max-width: 56rem;
    margin-inline: auto;
  }
  .home-spotlight__eyebrow {
    font-family: var(--font-body--family, sans-serif);
    font-size: .6875rem;
    letter-spacing: .36em;
    text-transform: uppercase;
    opacity: .7;
  }
  .home-spotlight__heading {
    font-family: var(--font-heading--family, serif);
    font-weight: 500;
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.6;
    letter-spacing: .05em;
    margin: 0;
    max-width: 17em;
  }
  .home-spotlight__text {
    font-family: var(--font-body--family, sans-serif);
    font-size: clamp(.9375rem, 1vw, 1.0625rem);
    line-height: 2;
    letter-spacing: .06em;
    margin: 0;
    max-width: 32em;
    opacity: .9;
  }
  .home-spotlight__btn {
    display: inline-flex;
    align-items: center;
    gap: .6em;
    margin-top: 6px;
    color: #fff;
    text-decoration: none;
    font-size: .875rem;
    letter-spacing: .1em;
  }
  .home-spotlight__btn-text {
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(255, 255, 255, .45);
    transition: border-color .25s;
  }
  .home-spotlight__btn:hover .home-spotlight__btn-text {
    border-color: #fff;
  }
  .home-spotlight__arrow {
    transition: transform .25s;
  }
  .home-spotlight__btn:hover .home-spotlight__arrow {
    transform: translateX(4px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home spotlight",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SPOTLIGHT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ひとつとして同じものがない、ムラーノの手仕事" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "色とりどりの手吹きガラス。あなたの暮らしに、ヴェネチアの光を。" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "コレクションを見る" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#d97a40" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 72 }
  ],
  "presets": [{ "name": "Home spotlight" }]
}
{% endschema %}
