{%- comment -%}
  Terra Arts: 临时静态分类入口。
  4 张分类图来自 assets/(cat-*.jpg)。等店铺建好真实 collection 后,
  可改回 collection-list section 或把下面的 link 换成各 collection 的 URL。
{%- endcomment -%}

{%- liquid
  assign all_url = routes.all_products_collection_url
-%}

<div class="home-cats color-{{ section.settings.color_scheme }}" style="--cats-pt: {{ section.settings.padding_top }}px; --cats-pb: {{ section.settings.padding_bottom }}px;">
  <div class="home-cats__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="home-cats__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="home-cats__grid">
      {%- assign tiles = 'cat-glass.jpg|グラス,cat-accessory.jpg|アクセサリー,cat-pen.jpg|ガラスペン,cat-watch.jpg|腕時計' | split: ',' -%}
      {%- for tile in tiles -%}
        {%- assign parts = tile | split: '|' -%}
        <a class="home-cats__tile" href="{{ all_url }}">
          <img
            class="home-cats__img"
            src="{{ parts[0] | asset_url }}"
            alt="{{ parts[1] }}"
            width="960"
            height="1200"
            loading="lazy"
          >
          <span class="home-cats__label">{{ parts[1] }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .home-cats {
    padding-block: var(--cats-pt, 48px) var(--cats-pb, 64px);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
  .home-cats__heading {
    text-align: center;
    margin: 0 0 32px;
    font-family: var(--font-primary--family, inherit);
    font-weight: 500;
  }
  .home-cats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .home-cats__tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 4 / 5;
    text-decoration: none;
  }
  .home-cats__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s cubic-bezier(.22,.61,.36,1);
  }
  .home-cats__tile:hover .home-cats__img {
    transform: scale(1.045);
  }
  .home-cats__label {
    position: absolute;
    left: 16px;
    bottom: 14px;
    color: #fff;
    font-family: var(--font-primary--family, inherit);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 500;
    letter-spacing: .04em;
    text-shadow: 0 1px 8px rgb(0 0 0 / .55);
    z-index: 1;
  }
  .home-cats__tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / .45), rgb(0 0 0 / 0) 45%);
    pointer-events: none;
  }
  @media screen and (max-width: 749px) {
    .home-cats__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "コレクションから探す" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "Home categories" }]
}
{% endschema %}
